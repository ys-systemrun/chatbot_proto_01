# 評価ランナー（ADR-0099）の設定。evals/.env にコピーして記入する（evals/.env は Git 管理外）。
# admin_ui の URL。apply-app の完了時に表示される admin_ui_alb_dns_name に http:// を付けたもの。
EVAL_BASE_URL=http://<admin-ui-alb-dns-name>

# LLM 採点の実行方法（ADR-0101）。bedrock（既定）または claude-code。
#   bedrock    : Amazon Bedrock を terraform/.env の AWS 認証情報で呼ぶ（AWS の従量課金）
#   claude-code: Claude Code の非対話モード（claude -p）をサブスクリプションで呼ぶ（使用量はサブスクリプションで賄う）
#                自分の端末で手動実行する場合に限る。定期実行・CI では使わない。
# EVAL_JUDGE_BACKEND=bedrock

# claude-code で採点するときのトークン。ホストで `claude setup-token` を実行して発行したもの（有効期限1年）。
# 発行した本人だけが使い、共有しない。ANTHROPIC_API_KEY は使わない（API 課金に切り替わるため、ランナーが外す）。
# CLAUDE_CODE_OAUTH_TOKEN=
