BOT_PORT=8000
FRONT_PORT=5173
STORYBOOK_PORT=6006
DB_PORT=5432
# db_init が hiroba_question_altered.embedding を VECTOR(N) で作成する際の次元数（IMPL-202608061016 / ADR-0017）。
# 埋め込みモデルの出力次元に合わせること（nomic-embed-text なら 768）。
# ローカル DB のデータは .local/volumes/ に保存される（ADR-0098, 旧 DB_DIR は廃止）。次元を変える場合は
# .local/volumes/knowledge_db を作り直すこと。
EMBEDDING_VECTOR_DIM=768

# シード元データ（db_init/data/ を /data にマウント）。情報源別ディレクトリ（ADR-0098）からの相対パス。
# フル版を使う場合は hiroba_qa/exportjson_withguid.json / hiroba_qa/question_altered.csv を指定する。
CSV_DATA_DIR=data
QA_ORIGINAL_FILE=hiroba_qa/small/exportjson_withguid.json
QUESTION_ALTERED_FILE=hiroba_qa/small/question_altered.csv
CATEGORY_FILE=hiroba_qa/category.csv

MODEL_EMBEDDING=text-embedding-nomic-embed-text-v1.5@q8_0
LMSTUDIO_EMBEDDING_URL=http://host.docker.internal:1234/v1/embeddings

MODEL_CHAT=google/gemma-4-e4b
LMSTUDIO_CHAT_URL=http://host.docker.internal:1234/v1/chat/completions

EVAL_QUERIES_CSV=eval_queries.csv
EVAL_NOISE_QUERIES_CSV=eval_noise_queries.csv

# Knowledge MCP サーバ（IMPL-202608041013）
KNOWLEDGE_MCP_PORT=8100
KNOWLEDGE_MCP_DEFAULT_TOP_K=5
# 管理UI用（IMPL-202608060837）: web_backend が MCPクライアントとして接続するエンドポイント
KNOWLEDGE_MCP_URL=http://knowledge_mcp:8100/mcp

# Tag Selector MCP サーバ（IMPL-202608051712）
TAG_SELECTOR_MCP_PORT=8200
# Conversation Agent（IMPL-202608061725）: agent_invitro が MCPクライアントとして接続する
TAG_SELECTOR_MCP_URL=http://tag_selector_mcp:8200/mcp
LLM_PROVIDER=lmstudio
# チャット補完に使用するモデル名（未指定時は docker-compose 側で MODEL_CHAT にフォールバック）
LMSTUDIO_CHAT_MODEL=google/gemma-4-e4b
TAXONOMY_RELOAD_INTERVAL_SEC=300
TAG_SELECTOR_DEFAULT_MAX_TAGS=3
TAG_SELECTOR_DEFAULT_CONFIDENCE_THRESHOLD=0.0

# --- Amazon Bedrock 切り替え（AWS 環境, IMPL-202608101616 / ADR-0031）---
# ローカル開発では lmstudio のまま変更不要。AWS 環境（ECS）でのみ以下を bedrock 系に設定する。
# チャット系（tag_selector_mcp, agent_invitro）: LLM_PROVIDER=bedrock
# 埋め込み系（knowledge_mcp, db_init）: EMBEDDING_PROVIDER=bedrock
EMBEDDING_PROVIDER=lmstudio
# Bedrock を呼び出す AWS リージョン（IMPL-202608101542 の aws_region と一致させる）。
BEDROCK_REGION=ap-northeast-1
# チャット用 Bedrock モデルID（Open Issue: 実装時に確定。例: Anthropic Claude 系）。
BEDROCK_CHAT_MODEL_ID=
# 埋め込み用 Bedrock モデルID（Open Issue: 例 Amazon Titan Text Embeddings V2 / Cohere Embed）。
# 選定モデルの出力次元に合わせて EMBEDDING_VECTOR_DIM も更新すること。
BEDROCK_EMBEDDING_MODEL_ID=