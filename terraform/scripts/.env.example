# Copy this to scripts/.env and fill in environment-specific values.
#   cp .env.example .env   (or: Copy-Item .env.example .env)
# scripts/.env is not tracked by Git (matched by the global ".env" ignore).
#
# SECURITY: this file holds AWS credentials in plaintext. Keep it local, never commit,
#           and prefer short-lived/STS credentials (set AWS_SESSION_TOKEN) over long-lived keys.

# --- AWS credentials (exported as env vars for terraform / aws CLI) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: required only for temporary/STS credentials
AWS_SESSION_TOKEN=

# Optional safety guard: deploy/destroy aborts if the authenticated account differs from this.
AWS_ACCOUNT_ID=

# Alternative to the keys above: use a named profile instead. If both are set, the keys win.
AWS_PROFILE=

# --- Terraform state ---
# S3 bucket name that stores Terraform state (globally unique). Created/used in Phase 0.
STATE_BUCKET=

# Note: region / Bedrock model ids / embedding_vector_dim are managed in
#       envs/verify/terraform.tfvars (do NOT put them here).
