# Copy this to terraform/.env and fill in the values.
#   cp .env.example .env   (or on Windows: Copy-Item .env.example .env)
# terraform/.env is not tracked by Git (matched by the global ".env" ignore).
#
# ADR-0040: 設定はこの単一 .env に集約する（terraform.tfvars は廃止）。
#   - AWS_* / STATE_*  … 認証・state 用。deploy が読み取り、TF_VAR / AWS ランタイム変数に反映する。
#   - TF_VAR_*         … terraform 変数。そのまま terraform に渡される（値は verbatim）。
# database / app 両構成の変数を1ファイルに書く。terraform は未宣言の TF_VAR_* を無視するため、
# 各構成は自分の変数だけを拾う（余剰は無害）。共有変数（埋め込みモデル等）は1エントリに統合する。
#
# SECURITY: this file holds AWS credentials in plaintext. Keep it local, never commit,
#           and prefer short-lived/STS credentials (set AWS_SESSION_TOKEN) over long-lived keys.
#
# 記法の注意（重要）:
#   - 値の後ろに「# コメント」を書かない（値の一部として扱われる）。説明は行頭 # の独立行に書く。
#   - リストは JSON で書く: TF_VAR_private_subnet_ids=["subnet-aaa","subnet-bbb"]
#   - 数値/真偽はそのまま: TF_VAR_embedding_vector_dim=1024 / TF_VAR_multi_az=false

# ============================================================================
# AWS 認証（deploy が boto3 / terraform 用に os.environ へ反映）
# ============================================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 一時認証(STS)のときだけ設定
AWS_SESSION_TOKEN=
# 名前付きプロファイルを使う場合は上の3つを空にしてここに指定（キーがあればキー優先）
AWS_PROFILE=

# ============================================================================
# 共通値（層をまたいで共有, ADR-0038）。deploy が TF_VAR_aws_region 等へ反映。
# ============================================================================
AWS_REGION=us-east-1
# 認証先アカウントの安全ガード（実 sts identity と不一致なら停止）。TF_VAR_aws_account_id にも反映。
AWS_ACCOUNT_ID=349131272460
# リソース名/タグ接頭辞。TF_VAR_name_prefix に反映（空なら各構成 default）。
NAME_PREFIX=chatbot-invitro

# ============================================================================
# Terraform state（S3 バックエンド）
# ============================================================================
# state バケット名（account-regional 名前空間, ADR-0039。Phase 0 bootstrap.bat で作成）。
STATE_BUCKET=chatbot-invitro-terraform-state-349131272460-us-east-1-an
STATE_KEY_DATABASE=database/state.tfstate
STATE_KEY_APP=app/state.tfstate

# ============================================================================
# terraform 変数（TF_VAR_*）— 旧 main/database/terraform.tfvars 相当
# ============================================================================
# 既存 VPC / プライベートサブネットの ID（ADR-0036, 基盤チームから受領）。
TF_VAR_vpc_id=
TF_VAR_private_subnet_ids=["subnet-aaaaaaaaaaaaaaaaa","subnet-bbbbbbbbbbbbbbbbb"]
# 既存 VPC のパブリックサブネット ID（admin_ui の ALB=internet-facing 配置用, ADR-0041/IMPL-202608211050）。
# 0章 Open Issue #2（基盤チーム確認）が解消するまで未確定。用意が無い場合は本書 5.1節の前提見直しが必要。
TF_VAR_public_subnet_ids=["subnet-cccccccccccccccc","subnet-dddddddddddddddd"]
# 既存 VPC 側に ECR/Logs/Secrets/Bedrock 等の EP が無ければ true。あれば false。
TF_VAR_create_vpc_endpoints=true
# RDS（pgvector 対応版を AWS 公式で要確認）
TF_VAR_rds_engine_version=16.4
TF_VAR_rds_instance_class=db.t4g.micro
TF_VAR_multi_az=false
# ADR-0037: 永続化運用。通常 true のまま（destroy-database が実行時に false を渡す）。
TF_VAR_deletion_protection=true
TF_VAR_skip_final_snapshot=true
# db_hiroba_qa_init のシードデータ（ADR-0034 でイメージに /data 同梱。値は "data"）。
TF_VAR_csv_data_dir=data
TF_VAR_qa_original_file=exportjson_withguid_small.json
TF_VAR_question_altered_file=question_altered_small.csv
TF_VAR_category_file=category.csv

# ============================================================================
# terraform 変数（TF_VAR_*）— 旧 main/app/terraform.tfvars 相当
# ============================================================================
# Service Connect 名前空間
TF_VAR_service_namespace=chatbot.internal
# Bedrock チャットモデル（要モデルアクセス有効化）。
# nova / claude 等オンデマンド非対応モデルは「推論プロファイルID」を指定すること
# （例: us-east-1 なら us.amazon.nova-2-lite-v1:0）。ベアのモデルIDだと Converse が
# ValidationException（on-demand throughput isn't supported）になる。
# 確認: aws bedrock list-inference-profiles
TF_VAR_bedrock_chat_model_id=
# MCP Inspector 検証イメージのタグ（app 構成）
TF_VAR_mcp_inspector_image_tag=latest
# admin_ui（管理UI, ADR-0041）の ALB へ 80 番インバウンドを許可する社内IP（CIDR リスト）。
# 0章 Open Issue #1（発注者から受領）が解消するまで未確定。空 [] だと誰も到達できない（=遮断）。
# 例: ["203.0.113.10/32","198.51.100.0/24"]
TF_VAR_admin_ui_allowed_cidrs=[]
# Bedrock コスト予算アラート（任意）。メールを1件以上指定すると AWS Budgets で通知。
TF_VAR_bedrock_monthly_budget_usd=50
TF_VAR_budget_alert_emails=[]

# ============================================================================
# 共有変数（database / app 両構成で使用。必ず同値であること）
# ============================================================================
# 埋め込みモデル（例: amazon.titan-embed-text-v2:0 / cohere.embed-multilingual-v3）
TF_VAR_bedrock_embedding_model_id=
# 埋め込み次元（選定モデルの出力次元に一致, §6.2 / ADR-0017）
TF_VAR_embedding_vector_dim=1024
# コンテナイメージタグ（database の seed 用 / app の常駐サービス用に共通）
TF_VAR_image_tag=latest
